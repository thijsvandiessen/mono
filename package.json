{
  "name": "mono-vandiessen",
  "version": "2.0.2",
  "private": true,
  "description": "Monorepo for small websites",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --build && pnpm run -r build",
    "codegen": "pnpm --filter @mono/data... download-schema && pnpm --filter @mono/data... codegen",
    "dev": "pnpm -r --parallel --stream dev",
    "e2e": "pnpm --filter @mono/e2e... e2e",
    "e2e:mock": "pnpm --filter @mono/e2e... e2e:mock",
    "e2e:install": "pnpm --filter @mono/e2e... install:browsers",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run -c ./vitest.config.ts",
    "test:coverage": "vitest run -c ./vitest.config.ts --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "dotenv": "18.0.10",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@11.29.0+sha512.d913f9b37cd5fe6780052e809774edabb7bdcf69a6e6d9b8fd3b38bc052fa8a7d891b6c201a38fb504a07ffce2e5e8c262ef54fb8f57db62f22d353a30bc8a96"
}
