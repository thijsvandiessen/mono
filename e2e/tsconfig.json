{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mono/typescript-config",
  "compilerOptions": {
    "types": ["@playwright/test", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./tests/**/*.ts",
    "./mock-tests/**/*.ts",
    "./mock-server/**/*.ts",
    "./playwright.config.ts",
    "./playwright.mock.config.ts"
  ]
}
