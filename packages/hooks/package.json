{
  "name": "@mono/hooks",
  "version": "1.0.0",
  "description": "hooks",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "pnpm run lint:js && pnpm run lint:styles",
    "lint:js": "oxlint",
    "lint:styles": "oxfmt . --write",
    "test": "vitest run -c ./vitest.config.ts"
  },
  "dependencies": {
    "@mono/data": "workspace:*",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@mono/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.6.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "dotenv": "18.0.10",
    "jsdom": "31.0.1",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
