{
  "name": "@mono/data",
  "version": "1.0.0",
  "description": "data",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "codegen": "graphql-codegen-esm --config ./codegen.ts",
    "codegen:watch": "graphql-codegen-esm --require dotenv/config --config ./codegen.ts --watch",
    "dev": "tsc --watch",
    "download-schema": "node ./src/download-schema.ts && pnpm run lint:styles",
    "lint": "pnpm run lint:js && pnpm run lint:styles",
    "lint:js": "oxlint",
    "lint:styles": "oxfmt . --write",
    "test": "vitest run -c ./vitest.config.ts"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "@mono/next-js": "workspace:*",
    "@mono/utils": "workspace:*",
    "@urql/core": "6.0.3",
    "@urql/exchange-graphcache": "9.0.2",
    "@urql/exchange-retry": "2.0.0",
    "graphql": "16.14.1",
    "react": "19.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@apollo/rover": "1.0.1",
    "@commitlint/config-conventional": "21.0.2",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@graphql-codegen/introspection": "7.0.0",
    "@mono/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "dotenv": "17.4.2",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
