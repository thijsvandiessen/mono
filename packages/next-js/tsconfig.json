{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mono/typescript-config",
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "rootDir": "src"
  },
  "include": ["src/**/*", "src/*"]
}
