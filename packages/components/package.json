{
  "name": "@mono/components",
  "version": "1.0.0",
  "private": true,
  "description": "components",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:scss && tsc",
    "build:scss": "cpx \"src/**/*.scss\" dist",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:scss": "cpx \"src/**/*.scss\" dist --watch",
    "dev:ts": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run -c ./vitest.config.ts"
  },
  "dependencies": {
    "@mono/data": "workspace:*",
    "@mono/hooks": "workspace:*",
    "@mono/next-js": "workspace:*",
    "@mono/search-site": "workspace:*",
    "@mono/site-config": "workspace:*",
    "@mono/utils": "workspace:*",
    "@react-google-maps/api": "2.20.8",
    "classnames": "2.5.1",
    "datocms-structured-text-utils": "6.0.1",
    "next-intl": "4.15.3",
    "react": "19.3.1",
    "react-datocms": "8.1.2",
    "react-dom": "19.3.1",
    "urql": "5.0.4"
  },
  "devDependencies": {
    "@mono/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cpx2": "9.0.3",
    "dotenv": "18.0.10",
    "jsdom": "31.0.1",
    "sass": "1.108.2",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
