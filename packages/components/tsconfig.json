{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mono/typescript-config",
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "rootDir": "src"
  },
  "references": [
    { "path": "../data" },
    { "path": "../utils" },
    { "path": "../next-js" },
    { "path": "../hooks" }
  ],
  "include": ["src/**/*", "src/*", "global.d.ts"],
  "exclude": [
    "src/**/*.scss",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__snapshots__",
    "src/vitest.setup.ts",
    "src/test-utils"
  ]
}
