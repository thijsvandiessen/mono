    "test": "vitest run -c ./vitest.config.ts"
  },
  "devDependencies": {
    "@mono/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "next": "16.4.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
